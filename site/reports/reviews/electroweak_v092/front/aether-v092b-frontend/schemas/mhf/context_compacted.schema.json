{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vanguard.dev/schemas/mhf/context_compacted.schema.json",
  "title": "ContextCompactedPayload",
  "type": "object",
  "additionalProperties": false,
  "required": ["inputDigest", "outputDigest"],
  "properties": {
    "inputDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "outputDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "strategy": {"type": ["string", "null"]},
    "tokensBefore": {"type": ["integer", "null"], "minimum": 0},
    "tokensAfter": {"type": ["integer", "null"], "minimum": 0},
    "removedTokens": {"type": ["integer", "null"], "minimum": 0}
  }
}
