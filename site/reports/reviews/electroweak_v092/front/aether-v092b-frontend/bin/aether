#!/usr/bin/env node

/**
 * AETHER — Self-Contained Production CLI Binary Entrypoint
 *
 * Runs without dev dependencies or repository-local path assumptions.
 */

import { dirname, resolve } from "node:path";
import { fileURLToPath } from "node:url";

const __filename = fileURLToPath(import.meta.url);
const __dirname = dirname(__filename);

// Resolve package root relative to bin directory
const packageRoot = resolve(__dirname, "..");
if (!process.env.AETHER_HOME) {
  process.env.AETHER_HOME = packageRoot;
}

// Forward to CLI entrypoint
const cliMain = resolve(packageRoot, "vanguard", "clients", "cli", "dist", "src", "main.js");

import(cliMain).catch((err) => {
  console.error(`[AETHER CLI] Fatal initialization error:`, err);
  process.exit(1);
});
