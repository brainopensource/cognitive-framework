{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vanguard.dev/schemas/mhf/execution_profile_v2.schema.json",
  "title": "ExecutionProfileV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["api", "id", "workspace", "process", "approval", "persistence", "evaluation", "assurance", "retention", "capture"],
  "properties": {
    "api": { "const": "mhf.execution-profile/2" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "workspace": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "access"],
      "properties": {
        "mode": { "enum": ["in-place", "sealed"] },
        "access": { "enum": ["read-only", "workspace-write"] }
      }
    },
    "process": {
      "type": "object", "additionalProperties": false,
      "required": ["backend", "fallback"],
      "properties": {
        "backend": { "enum": ["host", "platform-sandbox"] },
        "fallback": { "const": "deny" }
      }
    },
    "network": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["inherited", "denied", "allowlist"] },
        "allow": { "type": "array", "items": { "type": "string" } }
      }
    },
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["default"],
      "properties": {
        "default": { "enum": ["allow", "ask", "deny"] },
        "rules": { "type": "array", "items": { "type": "object" } }
      }
    },
    "persistence": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "durable"],
      "properties": {
        "mode": { "enum": ["sqlite-wal", "memory"] },
        "durable": { "type": "boolean" }
      }
    },
    "evaluation": {
      "type": "object", "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["none", "exterior"] },
        "absence_reason": { "type": "string", "minLength": 1 }
      }
    },
    "assurance": {
      "type": "object", "additionalProperties": false,
      "required": ["level", "attestation_required", "promotion_eligible"],
      "properties": {
        "level": { "enum": ["recorded", "hermetic"] },
        "attestation_required": { "type": "boolean" },
        "promotion_eligible": { "type": "boolean" }
      }
    },
    "retention": {
      "type": "string",
      "enum": ["digests_only", "standard", "full"]
    },
    "capture": {
      "type": "object", "additionalProperties": false,
      "required": ["content", "trainability", "required"],
      "properties": {
        "content": { "enum": ["redacted", "full"] },
        "trainability": { "const": "prohibited" },
        "required": { "type": "boolean" }
      }
    }
  }
}
