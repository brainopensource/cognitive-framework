{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vanguard.dev/schemas/v4/receipt.reader.schema.json",
  "$comment": "READER PROFILE, generated by tools/reader_profile.py. Do not edit.",
  "title": "Receipt",
  "type": "object",
  "required": [
    "descriptorDigest",
    "outcome",
    "observedAt",
    "resultDigest",
    "affectedResources"
  ],
  "properties": {
    "descriptorDigest": {
      "$ref": "primitives.reader.schema.json#/$defs/Digest"
    },
    "grantId": {
      "$ref": "primitives.reader.schema.json#/$defs/GrantId"
    },
    "outcome": {
      "enum": [
        "ok",
        "failed",
        "undeterminable"
      ]
    },
    "observedAt": {
      "$ref": "primitives.reader.schema.json#/$defs/Timestamp"
    },
    "resultDigest": {
      "$ref": "primitives.reader.schema.json#/$defs/Digest"
    },
    "affectedResources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "resource",
          "change"
        ],
        "properties": {
          "resource": {
            "type": "string",
            "minLength": 1
          },
          "change": {
            "enum": [
              "created",
              "modified",
              "deleted",
              "observed"
            ]
          },
          "preDigest": {
            "$ref": "primitives.reader.schema.json#/$defs/Digest"
          },
          "postDigest": {
            "$ref": "primitives.reader.schema.json#/$defs/Digest"
          },
          "patchRef": {
            "$ref": "primitives.reader.schema.json#/$defs/Digest"
          }
        },
        "additionalProperties": true
      }
    },
    "workingDirectory": {
      "type": "string",
      "minLength": 1
    },
    "uncertainty": {
      "type": "object",
      "required": [
        "scope",
        "reason"
      ],
      "properties": {
        "scope": {
          "enum": [
            "effect_occurrence",
            "evidence_completeness",
            "result"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "note": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "undeterminable"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "uncertainty"
        ]
      }
    }
  ]
}