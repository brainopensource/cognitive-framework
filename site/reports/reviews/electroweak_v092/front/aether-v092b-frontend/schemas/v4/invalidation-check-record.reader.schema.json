{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vanguard.dev/schemas/v4/invalidation-check-record.reader.schema.json",
  "$comment": "READER PROFILE, generated by tools/reader_profile.py. Do not edit.",
  "title": "InvalidationCheckRecord",
  "type": "object",
  "required": [
    "artifact",
    "conditionIndex",
    "lastChecked",
    "outcome"
  ],
  "properties": {
    "artifact": {
      "type": "string"
    },
    "conditionIndex": {
      "type": "integer",
      "minimum": 0
    },
    "lastChecked": {
      "$ref": "primitives.reader.schema.json#/$defs/Timestamp"
    },
    "outcome": {
      "enum": [
        "holds",
        "violated",
        "inconclusive"
      ]
    },
    "checkedBy": {
      "$ref": "primitives.reader.schema.json#/$defs/EvaluatorId"
    }
  },
  "additionalProperties": true
}