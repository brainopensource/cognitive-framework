{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vanguard.dev/schemas/v4/effect-descriptor.reader.schema.json",
  "$comment": "READER PROFILE, generated by tools/reader_profile.py. Do not edit.",
  "title": "EffectDescriptor",
  "type": "object",
  "required": [
    "verb",
    "sinkClass",
    "selector",
    "args",
    "argsDigest",
    "idempotencyKey",
    "riskTier",
    "provenance"
  ],
  "properties": {
    "verb": {
      "type": "string",
      "minLength": 1
    },
    "sinkClass": {
      "enum": [
        "pure",
        "observation",
        "privileged"
      ]
    },
    "selector": {
      "$ref": "resource-selector.reader.schema.json"
    },
    "args": {
      "type": "object"
    },
    "argsDigest": {
      "$ref": "primitives.reader.schema.json#/$defs/Digest"
    },
    "workingDirectory": {
      "type": "string",
      "minLength": 1
    },
    "readSet": {
      "type": "array",
      "items": {
        "$ref": "resource-selector.reader.schema.json"
      }
    },
    "writeSet": {
      "type": "array",
      "items": {
        "$ref": "resource-selector.reader.schema.json"
      }
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1
    },
    "riskTier": {
      "$ref": "primitives.reader.schema.json#/$defs/RiskTier"
    },
    "provenance": {
      "$ref": "primitives.reader.schema.json#/$defs/ProvenanceAxes"
    }
  },
  "additionalProperties": true
}