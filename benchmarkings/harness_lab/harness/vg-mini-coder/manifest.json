{
  "harness": "vg-mini-coder",
  "components": {
    "system_prompt": ["vg-mini-coder/system-prompt.txt"],
    "tools": [
      "vg-mini-coder/read-tool.json",
      "vg-mini-coder/patch-tool.json",
      "vg-mini-coder/test-tool.json"
    ],
    "context_policy": ["vg-mini-coder/context-policy.json"],
    "routing_policy": ["vg-mini-coder/routing-policy.json"],
    "approval_policy": ["vg-mini-coder/approval-policy.json"]
  },
  "capabilities": [
    {
      "verb": "fs.read",
      "sink": "observation",
      "selector": {"kind":"fs","root":"/workspace","paths":["/workspace"]},
      "risk": "low"
    },
    {
      "verb": "patch.apply",
      "sink": "privileged",
      "selector": {"kind":"fs","root":"/workspace","paths":["/workspace"]},
      "risk": "medium"
    },
    {
      "verb": "proc.exec",
      "sink": "privileged",
      "selector": {"kind":"generic","uriPattern":"proc://exec/allow/git,pytest,ruff,python3"},
      "risk": "high"
    }
  ],
  "evaluators": ["coding-oracle@3"],
  "budgetPolicy": "vg-mini-coder/budget-policy.json",
  "undeletable": false
}
