{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vanguard.dev/schemas/v4/gate-receipt.schema.json",
  "title": "Sprint 6B gate receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gate",
    "result",
    "subject_sha",
    "evidence_commit",
    "evidence_commit_relation",
    "commands",
    "implementer",
    "signer",
    "countersigner",
    "timestamp_utc",
    "environment"
  ],
  "properties": {
    "schema_version": { "const": "gts.gate-receipt.v1" },
    "gate": { "type": "string", "pattern": "^R([0-9]|10)$" },
    "result": { "enum": ["PASS", "FAIL", "BLOCKED"] },
    "subject_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "evidence_commit": { "type": "string", "minLength": 7 },
    "evidence_commit_relation": {
      "enum": ["same-commit", "ci-artifact", "follow-up-commit"]
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["argv", "exit_code", "stdout_sha256", "stderr_sha256"],
        "properties": {
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "exit_code": { "type": "integer" },
          "stdout_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "stderr_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "artifact_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    },
    "implementer": { "type": "string", "minLength": 1 },
    "signer": { "type": "string", "minLength": 1 },
    "countersigner": { "type": "string", "minLength": 1 },
    "timestamp_utc": { "type": "string", "minLength": 10 },
    "environment": {
      "type": "object",
      "required": ["python", "node", "os"],
      "properties": {
        "python": { "type": "string" },
        "node": { "type": "string" },
        "os": { "type": "string" }
      }
    },
    "notes": { "type": "string" }
  }
}
