{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vanguard.dev/schemas/v4/harness-manifest.schema.json",
  "$comment": "GTS-13C T7.3. References resolve and freeze to content digests at episode composition.",
  "title": "HarnessManifest",
  "type": "object",
  "required": ["harness", "components", "capabilities", "evaluators", "budgetPolicy"],
  "properties": {
    "harness": { "type": "string", "minLength": 1 },
    "components": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["verb", "sink", "selector", "risk"],
        "properties": {
          "verb": { "type": "string", "minLength": 1 },
          "sink": { "enum": ["pure", "observation", "privileged"] },
          "selector": { "$ref": "resource-selector.schema.json" },
          "risk": { "$ref": "primitives.schema.json#/$defs/RiskTier" }
        },
        "additionalProperties": false
      }
    },
    "evaluators": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "budgetPolicy": { "type": "string", "minLength": 1 },
    "undeletable": { "type": "boolean" }
  },
  "additionalProperties": false
}
