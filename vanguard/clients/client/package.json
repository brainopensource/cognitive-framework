{
  "name": "@aether/client",
  "version": "0.1.0",
  "private": true,
  "description": "AETHER runtime client: UDS socket, HTTP/SSE, Replay transports, and Signer ports",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./transports/socket.js": {
      "types": "./dist/src/transports/socket.d.ts",
      "default": "./dist/src/transports/socket.js"
    },
    "./transports/http.js": {
      "types": "./dist/src/transports/http.d.ts",
      "default": "./dist/src/transports/http.js"
    },
    "./transports/replay.js": {
      "types": "./dist/src/transports/replay.d.ts",
      "default": "./dist/src/transports/replay.js"
    },
    "./signers/operator-signer.js": {
      "types": "./dist/src/signers/operator-signer.d.ts",
      "default": "./dist/src/signers/operator-signer.js"
    },
    "./signers/web-signer.js": {
      "types": "./dist/src/signers/web-signer.d.ts",
      "default": "./dist/src/signers/web-signer.js"
    },
    "./transports/fake.js": {
      "types": "./dist/src/transports/fake.d.ts",
      "default": "./dist/src/transports/fake.js"
    },
    "./application/run-view.js": {
      "types": "./dist/src/application/run-view.d.ts",
      "default": "./dist/src/application/run-view.js"
    },
    "./application/trace-graph.js": {
      "types": "./dist/src/application/trace-graph.d.ts",
      "default": "./dist/src/application/trace-graph.js"
    },
    "./application/budget.js": {
      "types": "./dist/src/application/budget.d.ts",
      "default": "./dist/src/application/budget.js"
    },
    "./application/coding-types.js": {
      "types": "./dist/src/application/coding-types.d.ts",
      "default": "./dist/src/application/coding-types.js"
    },
    "./application/graph-model.js": {
      "types": "./dist/src/application/graph-model.d.ts",
      "default": "./dist/src/application/graph-model.js"
    },
    "./application/mcnemar.js": {
      "types": "./dist/src/application/mcnemar.d.ts",
      "default": "./dist/src/application/mcnemar.js"
    },
    "./application/projection-model.js": {
      "types": "./dist/src/application/projection-model.d.ts",
      "default": "./dist/src/application/projection-model.js"
    },
    "./application/approvals.js": {
      "types": "./dist/src/application/approvals.d.ts",
      "default": "./dist/src/application/approvals.js"
    },
    "./application/subscribe-run.js": {
      "types": "./dist/src/application/subscribe-run.d.ts",
      "default": "./dist/src/application/subscribe-run.js"
    },
    "./application/selectors.js": {
      "types": "./dist/src/application/selectors.d.ts",
      "default": "./dist/src/application/selectors.js"
    },
    "./application/coding-receipts.js": {
      "types": "./dist/src/application/coding-receipts.d.ts",
      "default": "./dist/src/application/coding-receipts.js"
    }
  },
  "files": [
    "dist/src/**/*.js",
    "dist/src/**/*.d.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build --silent && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@aether/contracts": "*",
    "@aether/projections": "*",
    "canonicalize": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
