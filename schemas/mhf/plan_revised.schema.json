{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vanguard.dev/schemas/mhf/plan_revised.schema.json",
  "title": "PlanRevisedPayload",
  "type": "object",
  "additionalProperties": false,
  "required": ["revision", "planDigest"],
  "properties": {
    "revision": {"type": "integer", "minimum": 0},
    "planDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "previousPlanDigest": {"type": ["string", "null"], "pattern": "^(sha256:[0-9a-f]{64})?$"},
    "planArtifact": {"type": ["string", "null"], "pattern": "^(sha256:[0-9a-f]{64})?$"},
    "rationaleDigest": {"type": ["string", "null"], "pattern": "^(sha256:[0-9a-f]{64})?$"}
  }
}
