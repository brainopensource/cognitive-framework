{
  "api": "mhf.manifest/2",
  "harness": "vg-formal-default",
  "components": {
    "system_prompt": ["system-prompt.txt"],
    "tools":         ["check-tool.json", "emit-tool.json"],
    "context_policy":  ["../code-default/context-policy.json"],
    "routing_policy":  ["../code-default/routing-policy.json"],
    "approval_policy": ["../code-default/approval-policy.json"]
  },
  "capabilities": [
    { "verb": "formal.assert", "sink": "observation",
      "selector": {"kind":"formal","root":"/workspace","paths":["/workspace/goals"]},
      "risk": "low" },
    { "verb": "formal.check",  "sink": "observation",
      "selector": {"kind":"formal","root":"/workspace","paths":["/workspace/goals"]},
      "risk": "low" },
    { "verb": "proof.emit",    "sink": "privileged",
      "selector": {"kind":"fs","root":"/workspace","paths":["/workspace/proofs"]},
      "risk": "high" }
  ],
  "budgetPolicy": "../code-default/budget-policy.json",
  "undeletable": false
}
