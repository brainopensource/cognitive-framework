{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vanguard.dev/schemas/mhf/topology.schema.json",
  "title": "TopologyArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["topologyId", "version", "entryRole", "roles", "edges", "artifactFlows"],
  "properties": {
    "api": {"type": "string", "const": "mhf.topology/1"},
    "topologyId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "version": {"type": "string", "minLength": 1},
    "entryRole": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/TopologyRole"}
    },
    "edges": {
      "type": "array",
      "items": {"$ref": "#/$defs/TopologyEdge"}
    },
    "artifactFlows": {
      "type": "array",
      "items": {"$ref": "#/$defs/ArtifactFlow"}
    }
  },
  "$defs": {
    "TopologyRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "policyRef"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "policyRef": {"type": "string", "minLength": 1},
        "scope": {"type": "object"},
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "usd_micros": {"type": "integer", "minimum": 0},
            "millis": {"type": "integer", "minimum": 0},
            "tokens": {"type": "integer", "minimum": 0},
            "bytes": {"type": "integer", "minimum": 0},
            "turns": {"type": "integer", "minimum": 0},
            "depth": {"type": "integer", "minimum": 0},
            "maxTurns": {"type": "integer", "minimum": 0},
            "maxDepth": {"type": "integer", "minimum": 0}
          }
        },
        "context": {"type": "object"}
      }
    },
    "TopologyEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "to": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "relation": {
          "type": "string",
          "enum": ["may_delegate_to", "reviews", "merges_into"]
        }
      }
    },
    "ArtifactFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "from", "to"],
      "properties": {
        "artifact": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "from": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "to": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "schemaId": {"type": "string", "minLength": 1}
      }
    }
  }
}
