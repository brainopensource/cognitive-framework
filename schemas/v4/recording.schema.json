{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vanguard.dev/schemas/v4/recording.schema.json",
  "$comment": "Owning section: GTS-13C T1.11. Complete inputs distinguish state replay from counterfactual re-execution.",
  "title": "Recording",
  "type": "object",
  "required": ["modelCassetteDigest", "imageDigest", "envSnapshotDigest", "seed", "clockPolicy"],
  "properties": {
    "modelCassetteDigest": { "$ref": "primitives.schema.json#/$defs/Digest" },
    "imageDigest": { "$ref": "primitives.schema.json#/$defs/Digest" },
    "envSnapshotDigest": { "$ref": "primitives.schema.json#/$defs/Digest" },
    "seed": { "$ref": "primitives.schema.json#/$defs/IntString" },
    "clockPolicy": { "enum": ["recorded", "fixed", "logical"] }
  },
  "additionalProperties": false
}
