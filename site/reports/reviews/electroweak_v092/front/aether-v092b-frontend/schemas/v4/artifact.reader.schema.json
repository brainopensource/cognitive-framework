{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vanguard.dev/schemas/v4/artifact.reader.schema.json",
  "$comment": "READER PROFILE, generated by tools/reader_profile.py. Do not edit.",
  "title": "Artifact",
  "type": "object",
  "required": [
    "artifactId",
    "kind",
    "class",
    "hypothesis",
    "evidenceRefs",
    "invalidationConditions",
    "riskDelta",
    "contentDigest"
  ],
  "properties": {
    "artifactId": {
      "$ref": "primitives.reader.schema.json#/$defs/ArtifactId"
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "class": {
      "enum": [
        "enforcement",
        "compensation"
      ]
    },
    "compensatesFor": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "$ref": "primitives.reader.schema.json#/$defs/Digest"
      }
    },
    "invalidationConditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "condition",
          "checkKind"
        ],
        "properties": {
          "condition": {
            "type": "string",
            "minLength": 1
          },
          "checkKind": {
            "enum": [
              "automatic",
              "scheduled",
              "manual"
            ]
          },
          "checkRef": {
            "$ref": "primitives.reader.schema.json#/$defs/EvaluatorId"
          }
        },
        "additionalProperties": true
      }
    },
    "riskDelta": {
      "type": "integer"
    },
    "contentDigest": {
      "$ref": "primitives.reader.schema.json#/$defs/Digest"
    }
  },
  "additionalProperties": true,
  "oneOf": [
    {
      "properties": {
        "class": {
          "const": "compensation"
        }
      },
      "required": [
        "class",
        "compensatesFor"
      ]
    },
    {
      "properties": {
        "class": {
          "const": "enforcement"
        }
      },
      "required": [
        "class"
      ],
      "not": {
        "required": [
          "compensatesFor"
        ]
      }
    }
  ]
}