{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vanguard.dev/schemas/v4/process-instance.reader.schema.json",
  "$comment": "READER PROFILE, generated by tools/reader_profile.py. Do not edit.",
  "title": "ProcessInstance",
  "type": "object",
  "required": [
    "processId",
    "definitionDigest",
    "currentState",
    "allowedTransitions",
    "pendingApprovals",
    "boundEffectVerbs",
    "history"
  ],
  "properties": {
    "processId": {
      "$ref": "primitives.reader.schema.json#/$defs/ProcessId"
    },
    "definitionDigest": {
      "$ref": "primitives.reader.schema.json#/$defs/Digest"
    },
    "currentState": {
      "type": "string",
      "minLength": 1
    },
    "allowedTransitions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pendingApprovals": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "primitives.reader.schema.json#/$defs/ApprovalId"
      }
    },
    "boundEffectVerbs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "eventKind",
          "to",
          "eventId"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "eventKind": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "eventId": {
            "$ref": "primitives.reader.schema.json#/$defs/Uuidv7"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}