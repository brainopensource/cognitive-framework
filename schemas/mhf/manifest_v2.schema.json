{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vanguard.dev/schemas/mhf/manifest_v2.schema.json",
  "title": "NamedManifestV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["api", "id", "components", "entrypoints"],
  "anyOf": [{ "required": ["ceiling"] }, { "required": ["capabilities"] }],
  "properties": {
    "api": { "const": "mhf.manifest/2" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "components": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/Component" } },
    "bindings": { "type": "array", "items": { "$ref": "#/$defs/Binding" } },
    "entrypoints": { "anyOf": [
      { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
      { "type": "object", "minProperties": 1, "additionalProperties": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          { "type": "object", "additionalProperties": false, "required": ["component"],
            "properties": { "component": { "type": "string", "minLength": 1 }, "interface": { "type": "string", "minLength": 1 } } }
        ]
      } }
    ] },
    "profiles": { "type": "object", "additionalProperties": { "type": "object" } },
    "ceiling": { "type": "array", "items": { "$ref": "#/$defs/Selector" } },
    "capabilities": { "type": "array", "items": { "$ref": "#/$defs/Capability" } },
    "model_routes": { "type": "array", "items": { "type": "object" } },
    "budget": { "type": "object" }, "system_prompt": { "type": ["string", "null"] },
    "approval_policy": { "type": ["string", "null"] }, "guardrails": { "type": "object" },
    "undeletable": { "type": "boolean" }
  },
  "$defs": {
    "Component": { "type": "object", "additionalProperties": false, "required": ["config", "ceiling", "isolation", "interfaces"],
      "anyOf": [
        { "required": ["kind", "ref"] },
        { "required": ["kind", "implementation"] },
        { "required": ["spi", "ref"] },
        { "required": ["role", "ref"] }
      ],
      "properties": {
        "kind": { "enum": ["planner", "context", "memory", "toolkit", "evaluation", "IPlanner", "IContextManager", "IMemoryEngine", "IToolkit", "IEvaluationGate"] },
        "spi": { "type": "string" }, "role": { "type": "string" }, "ref": { "type": "string", "minLength": 1 }, "implementation": { "type": "string", "minLength": 1 },
        "config": { "oneOf": [{ "type": "object" }, { "type": "string", "minLength": 1 }] }, "ceiling": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Selector" } },
        "isolation": { "enum": ["in_process", "subprocess", "container", "wasm"] }, "interfaces": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "entrypoints": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "authority": { "type": "boolean" }
      } },
    "Binding": { "type": "object", "additionalProperties": false, "required": ["from", "to"],
      "anyOf": [{ "required": ["interface"] }, { "required": ["relation"] }, { "required": ["channel"] }],
      "properties": {
        "from": { "type": "string", "minLength": 1 }, "to": { "type": "string", "minLength": 1 }, "interface": { "type": "string", "minLength": 1 }, "relation": { "type": "string", "minLength": 1 }, "channel": { "type": "string", "minLength": 1 }, "lazy": { "type": "boolean" }
      } },
    "Capability": { "type": "object", "additionalProperties": false, "required": ["verb", "selector"], "properties": { "verb": { "type": "string" }, "selector": { "$ref": "#/$defs/Selector" } } },
    "Selector": { "type": "object", "required": ["kind"], "properties": { "kind": { "enum": ["fs", "network", "secret", "git", "table", "browser", "generic"] }, "root": { "type": "string" }, "paths": { "type": "array" }, "uriPattern": { "type": "string" } } }
  }
}
