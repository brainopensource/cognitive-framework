{
  "name": "@vanguard/studio",
  "version": "0.4.1-beta",
  "private": true,
  "description": "AETHER Observatory / Meta-Harness Studio frontend client",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:browser": "node scripts/build-browser.mjs",
    "dev": "npm run build:browser && node scripts/serve-browser.mjs",
    "preview": "npm run build:browser && node scripts/serve-browser.mjs",
    "prebuild": "npm run build --prefix ../client-core --silent",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretypecheck": "npm run build --prefix ../client-core --silent",
    "test": "npm run build --silent && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@vanguard/client-core": "file:../client-core",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2"
  }
}
