{
  "harness": "vg-code-claude-shaped",
  "components": {
    "system_prompt": ["vg-code-claude-shaped/system-prompt.txt"],
    "tools": [
      "vg-code-claude-shaped/read-tool.json",
      "vg-code-claude-shaped/edit-tool.json",
      "vg-code-claude-shaped/bash-tool.json",
      "vg-code-claude-shaped/glob-tool.json",
      "vg-code-claude-shaped/grep-tool.json"
    ],
    "context_policy": ["vg-code-claude-shaped/context-policy.json"],
    "routing_policy": ["vg-code-claude-shaped/routing-policy.json"]
  },
  "capabilities": [
    {
      "verb": "fs.read",
      "sink": "observation",
      "selector": {"kind":"fs","root":"/workspace","paths":["/workspace"]},
      "risk": "low"
    },
    {
      "verb": "fs.search",
      "sink": "observation",
      "selector": {"kind":"fs","root":"/workspace","paths":["/workspace"]},
      "risk": "low"
    },
    {
      "verb": "patch.apply",
      "sink": "privileged",
      "selector": {"kind":"fs","root":"/workspace","paths":["/workspace"]},
      "risk": "medium"
    },
    {
      "verb": "proc.exec",
      "sink": "privileged",
      "selector": {"kind":"generic","uriPattern":"proc://exec/allow/git,pytest,ruff,python3,bash,sh,ls,find,grep,cat"},
      "risk": "high"
    }
  ],
  "evaluators": ["coding-oracle@3"],
  "budgetPolicy": "vg-code-claude-shaped/budget-policy.json",
  "undeletable": false
}
