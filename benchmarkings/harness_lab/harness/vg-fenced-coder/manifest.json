{
  "harness": "vg-fenced-coder",
  "components": {
    "system_prompt": ["vg-fenced-coder/SYSTEM_PROMPT.md"],
    "tools": [
      "vg-fenced-coder/read-tool.json",
      "vg-fenced-coder/patch-tool.json",
      "vg-fenced-coder/exec-tool.json"
    ],
    "context_policy": ["vg-fenced-coder/context-policy.json"],
    "routing_policy": ["vg-fenced-coder/routing-policy.json"],
    "approval_policy": ["vg-fenced-coder/approval-policy.json"]
  },
  "capabilities": [
    {"verb":"fs.read","sink":"observation","selector":{"kind":"fs","root":"/workspace","paths":["/workspace"]},"risk":"low"},
    {"verb":"patch.apply","sink":"privileged","selector":{"kind":"fs","root":"/workspace","paths":["/workspace"]},"risk":"medium"},
    {"verb":"proc.exec","sink":"privileged","selector":{"kind":"generic","uriPattern":"proc://exec/allow/git,pytest,ruff,python3"},"risk":"high"}
  ],
  "evaluators": ["coding-oracle@3"],
  "budgetPolicy": "vg-fenced-coder/budget-policy.json",
  "undeletable": false
}
