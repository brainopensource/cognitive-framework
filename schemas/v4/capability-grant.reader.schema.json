{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vanguard.dev/schemas/v4/capability-grant.reader.schema.json",
  "$comment": "READER PROFILE, generated by tools/reader_profile.py. Do not edit.",
  "title": "CapabilityGrant",
  "type": "object",
  "required": [
    "id",
    "principal",
    "descriptorDigest",
    "actions",
    "resources",
    "constraints",
    "purposeDigest"
  ],
  "properties": {
    "id": {
      "$ref": "primitives.reader.schema.json#/$defs/GrantId"
    },
    "principal": {
      "$ref": "primitives.reader.schema.json#/$defs/PrincipalId"
    },
    "descriptorDigest": {
      "$ref": "primitives.reader.schema.json#/$defs/Digest",
      "$comment": "CT-51: the exact normalised call this grant authorises. NOT purposeDigest. Verified at 05 \u00a72.1 S8."
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "resource-selector.reader.schema.json"
      },
      "minItems": 1,
      "$comment": "CT-24: a grant without a resource scope is a verb lattice, which is the defect this type exists to remove."
    },
    "constraints": {
      "type": "object",
      "required": [
        "expiresAt",
        "maxUses",
        "budgetLeaseId"
      ],
      "properties": {
        "expiresAt": {
          "$ref": "primitives.reader.schema.json#/$defs/Timestamp"
        },
        "maxUses": {
          "$ref": "primitives.reader.schema.json#/$defs/IntString"
        },
        "maxBytes": {
          "$ref": "primitives.reader.schema.json#/$defs/IntString"
        },
        "maxEffects": {
          "$ref": "primitives.reader.schema.json#/$defs/IntString"
        },
        "budgetLeaseId": {
          "$ref": "primitives.reader.schema.json#/$defs/LeaseId"
        },
        "environmentSnapshot": {
          "$ref": "primitives.reader.schema.json#/$defs/Digest"
        },
        "networkPolicy": {
          "enum": [
            "deny",
            "allowlist"
          ]
        },
        "requirePreview": {
          "type": "boolean"
        },
        "requireApprovalAboveRisk": {
          "$ref": "primitives.reader.schema.json#/$defs/RiskTier"
        }
      },
      "additionalProperties": true
    },
    "purposeDigest": {
      "$ref": "primitives.reader.schema.json#/$defs/Digest",
      "$comment": "04 \u00a73.3: intent binding. The effect binds to brief, purpose and approval rather than to inferred causality."
    },
    "parentGrantId": {
      "$ref": "primitives.reader.schema.json#/$defs/GrantId"
    },
    "approvalRef": {
      "$ref": "primitives.reader.schema.json#/$defs/ApprovalId"
    },
    "authenticator": {
      "type": "string",
      "$comment": "CT-26: required when the grant crosses a process boundary."
    }
  },
  "additionalProperties": true
}