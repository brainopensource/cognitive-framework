{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vanguard.dev/schemas/v4/capability-grant.reader.schema.json",
  "$comment": "READER PROFILE, generated by tools/reader_profile.py. Do not edit.",
  "title": "CapabilityGrant",
  "type": "object",
  "required": [
    "grantId",
    "principal",
    "descriptorDigest",
    "actions",
    "selector",
    "constraints",
    "expiry",
    "maxUses",
    "purposeDigest"
  ],
  "properties": {
    "grantId": {
      "$ref": "primitives.reader.schema.json#/$defs/GrantId"
    },
    "principal": {
      "$ref": "primitives.reader.schema.json#/$defs/PrincipalId"
    },
    "descriptorDigest": {
      "$ref": "primitives.reader.schema.json#/$defs/Digest"
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "selector": {
      "$ref": "resource-selector.reader.schema.json"
    },
    "constraints": {
      "type": "object",
      "required": [
        "budgetLeaseId"
      ],
      "properties": {
        "maxBytes": {
          "$ref": "primitives.reader.schema.json#/$defs/IntString"
        },
        "maxEffects": {
          "$ref": "primitives.reader.schema.json#/$defs/IntString"
        },
        "budgetLeaseId": {
          "$ref": "primitives.reader.schema.json#/$defs/LeaseId"
        },
        "environmentSnapshot": {
          "$ref": "primitives.reader.schema.json#/$defs/Digest"
        },
        "networkPolicy": {
          "enum": [
            "deny",
            "allowlist"
          ]
        },
        "requirePreview": {
          "type": "boolean"
        },
        "requireApprovalAboveRisk": {
          "$ref": "primitives.reader.schema.json#/$defs/RiskTier"
        }
      },
      "additionalProperties": true
    },
    "expiry": {
      "$ref": "primitives.reader.schema.json#/$defs/Timestamp"
    },
    "maxUses": {
      "$ref": "primitives.reader.schema.json#/$defs/IntString"
    },
    "purposeDigest": {
      "$ref": "primitives.reader.schema.json#/$defs/Digest"
    },
    "parentGrantId": {
      "$ref": "primitives.reader.schema.json#/$defs/GrantId"
    },
    "approvalRef": {
      "$ref": "primitives.reader.schema.json#/$defs/ApprovalId"
    },
    "authenticator": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}