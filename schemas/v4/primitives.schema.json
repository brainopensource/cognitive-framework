{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vanguard.dev/schemas/v4/primitives.schema.json",
  "$comment": "Owning section: 04 §1. Shared scalar and identifier definitions. Referenced by every other v4 schema.",
  "title": "Vanguard v4 primitives",
  "$defs": {
    "SchemaVersion": { "const": "vg.4" },
    "Timestamp": {
      "type": "string",
      "$comment": "CT-08: RFC 3339 UTC, millisecond precision.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "Digest": {
      "type": "string",
      "$comment": "CT-09: one digest format, everywhere.",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "IntString": {
      "type": "string",
      "$comment": "CT-06 / §0.4: any value that may exceed 2^53-1 is a decimal string.",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "Millis": { "type": "integer", "minimum": 0, "$comment": "CT-07: no floating point for durations." },
    "UsdMicros": { "$ref": "#/$defs/IntString", "$comment": "CT-06: integer micro-units, never floats." },
    "Uuidv7": {
      "type": "string",
      "$comment": "CT-14: indexing aid; causal order is carried by EventEnvelope.seq.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "Identifier": { "type": "string", "minLength": 1, "maxLength": 128 },
    "RunId": { "$ref": "#/$defs/Identifier" },
    "EpisodeId": { "$ref": "#/$defs/Identifier" },
    "BranchId": { "type": "integer", "minimum": 0 },
    "TaskId": { "$ref": "#/$defs/Identifier" },
    "ArtifactId": { "$ref": "#/$defs/Identifier" },
    "ClaimId": { "$ref": "#/$defs/Identifier" },
    "GrantId": { "$ref": "#/$defs/Identifier" },
    "LeaseId": { "$ref": "#/$defs/Identifier" },
    "ApprovalId": { "$ref": "#/$defs/Identifier" },
    "CandidateId": { "$ref": "#/$defs/Identifier" },
    "PrincipalId": { "$ref": "#/$defs/Identifier" },
    "TenantId": { "$ref": "#/$defs/Identifier" },
    "OwnerId": { "$ref": "#/$defs/Identifier" },
    "EvaluatorId": { "$ref": "#/$defs/Identifier" },
    "ToolCallId": {
      "$ref": "#/$defs/Identifier",
      "$comment": "CT-15: provider-assigned; echoed verbatim, never regenerated, normalised or trimmed."
    },
    "ResourceUri": { "type": "string", "minLength": 1 },
    "RiskTier": { "enum": ["low", "medium", "high", "critical"] },
    "ConfidentialityLabel": { "enum": ["public", "internal", "confidential", "restricted"] },
    "RetentionClass": { "enum": ["ephemeral", "standard", "extended", "legal_hold"] },
    "TrainabilityLabel": { "enum": ["prohibited", "opt_in_required", "opt_in_granted"] },
    "RedactionStatus": { "enum": ["none", "partial", "complete", "pending"] },
    "EpistemicState": {
      "$comment": "04 §4: orthogonal to provenance. Trust of origin is not strength of belief.",
      "enum": ["observed", "derived", "hypothesised", "corroborated", "contradicted", "retracted"]
    },
    "ProvenanceAxes": {
      "$comment": "04 §3.1: six independent axes; a single ordered lattice conflates them.",
      "type": "object",
      "required": ["origin", "instructionAuthority", "integrity", "confidentiality", "epistemic"],
      "properties": {
        "origin": { "enum": ["operator", "system", "environment", "model", "external", "memory"] },
        "instructionAuthority": { "enum": ["directive", "advisory", "inert"] },
        "integrity": { "enum": ["attested", "verified", "unverified", "tampered"] },
        "confidentiality": { "$ref": "#/$defs/ConfidentialityLabel" },
        "epistemic": { "$ref": "#/$defs/EpistemicState" },
        "influence": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
