{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vanguard.dev/schemas/v4/worker_protocol.schema.json",
  "$comment": "Owning contract: S6B-MD-005, REQ-SEC-001. Worker execution request and receipt protocol.",
  "title": "WorkerProtocol",
  "type": "object",
  "required": ["version", "requestId", "verb", "args"],
  "properties": {
    "version": { "const": "vg.4" },
    "requestId": { "type": "string", "minLength": 1 },
    "verb": {
      "enum": [
        "fs.read",
        "fs.search",
        "fs.write",
        "patch.apply",
        "fs.patch",
        "proc.exec",
        "proc.test"
      ]
    },
    "args": { "type": "object" },
    "workspaceRoot": { "type": "string" },
    "timeoutMillis": { "type": "integer", "minimum": 1 },
    "receipt": {
      "type": "object",
      "required": ["status", "occurrence"],
      "properties": {
        "status": { "enum": ["ok", "error", "timeout", "cancelled"] },
        "occurrence": { "enum": ["occurred", "did_not_occur", "undeterminable"] },
        "output": { "type": "string" },
        "stdoutDigest": { "type": "string" },
        "exitCode": { "type": "integer" },
        "containment": {
          "type": "object",
          "properties": {
            "rootless": { "type": "boolean" },
            "networkDenied": { "type": "boolean" },
            "filesystemIsolated": { "type": "boolean" }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
