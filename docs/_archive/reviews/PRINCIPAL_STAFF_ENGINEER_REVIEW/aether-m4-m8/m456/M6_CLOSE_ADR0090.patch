+    "ChildSpawned": frozenset({"spawn_adapter"}),
+    "ChildReturned": frozenset({"spawn_adapter"}),
     "PluginDiscovered": frozenset({"registry"}),
     "PluginResolved": frozenset({"registry"}),
     "PluginVerified": frozenset({"registry"}),
