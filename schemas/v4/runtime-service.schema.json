{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vanguard.dev/schemas/v4/runtime-service.schema.json",
  "$comment": "Owning contract: REQ-CLI-002, S6B-SA-001, DEC-6B-011, ADR-0062, ADR-0101, ADR-0103. Discriminated RuntimeServiceFrame union: CommandFrame | ReceiptFrame | EventFrame | ErrorFrame. Frame algebra frozen per docs/_archive/reviews/frontend/integration_plan.md §4.2-4.5.",
  "title": "RuntimeServiceFrame",
  "oneOf": [
    { "$ref": "#/$defs/CommandFrame" },
    { "$ref": "#/$defs/ReceiptFrame" },
    { "$ref": "#/$defs/EventFrame" },
    { "$ref": "#/$defs/ErrorFrame" }
  ],
  "$defs": {
    "CommandFrame": {
      "type": "object",
      "required": ["version", "frameType", "frameId", "command"],
      "properties": {
        "version": { "const": "vg.4" },
        "frameType": { "const": "command" },
        "frameId": { "type": "string", "minLength": 1 },
        "command": { "$ref": "#/$defs/Command" }
      },
      "additionalProperties": false
    },
    "ReceiptFrame": {
      "type": "object",
      "required": ["version", "frameType", "frameId", "receipt"],
      "properties": {
        "version": { "const": "vg.4" },
        "frameType": { "const": "receipt" },
        "frameId": { "type": "string", "minLength": 1 },
        "inReplyTo": { "type": "string", "minLength": 1 },
        "receipt": { "$ref": "#/$defs/CommandReceipt" }
      },
      "additionalProperties": false
    },
    "EventFrame": {
      "type": "object",
      "required": ["version", "frameType", "frameId", "event"],
      "properties": {
        "version": { "const": "vg.4" },
        "frameType": { "const": "event" },
        "frameId": { "type": "string", "minLength": 1 },
        "event": { "$ref": "event-envelope.schema.json" }
      },
      "additionalProperties": false
    },
    "ErrorFrame": {
      "type": "object",
      "required": ["version", "frameType", "frameId", "error"],
      "properties": {
        "version": { "const": "vg.4" },
        "frameType": { "const": "error" },
        "frameId": { "type": "string", "minLength": 1 },
        "inReplyTo": { "type": "string", "minLength": 1 },
        "error": { "$ref": "#/$defs/ServiceError" }
      },
      "additionalProperties": false
    },

    "SeqGuard": {
      "$comment": "Optimistic-concurrency guard on a run's current sequence. A mismatch is a `conflict`, never a silent overwrite. Accepts a JSON integer or the CT-06 decimal-string form used by afterSeq, because a run sequence may exceed 2^53-1.",
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        { "$ref": "primitives.schema.json#/$defs/IntString" }
      ]
    },
    "ErrorCode": {
      "$comment": "Canonical vocabulary shared byte-for-byte with client-core ClientFailure.code (TS) and service/contract.py ERROR_CODES (Python).",
      "enum": [
        "invalid_request",
        "unauthenticated",
        "permission_denied",
        "not_found",
        "conflict",
        "incompatible_version",
        "frame_too_large",
        "rate_limited",
        "not_available",
        "internal"
      ]
    },
    "ServiceError": {
      "type": "object",
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "$ref": "#/$defs/ErrorCode" },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "correlationId": { "type": "string" },
        "detail": { "type": "string" }
      },
      "additionalProperties": false
    },
    "CommandReceipt": {
      "type": "object",
      "required": ["commandId", "status"],
      "properties": {
        "commandId": { "type": "string", "minLength": 1 },
        "status": { "enum": ["completed", "error"] },
        "runId": { "$ref": "primitives.schema.json#/$defs/RunId" },
        "result": { "type": "object" },
        "error": { "$ref": "#/$defs/ServiceError" },
        "detail": { "type": "string" }
      },
      "additionalProperties": false
    },

    "ApprovalDecision": {
      "$comment": "Sole authority: approval-decision.schema.json. This slot inlined a near-copy whose `signature` was `minLength: 1` while the standalone schema requires the 128-hex Ed25519 form both signers actually emit (governance/approvals.py `.hex()`, client-core signer.ts `toString(\"hex\")`). The weaker of two copies guarded ingress, so the copy is retired in favour of the reference.",
      "$ref": "approval-decision.schema.json"
    },

    "Command": {
      "oneOf": [
        { "$ref": "#/$defs/StartRunCommand" },
        { "$ref": "#/$defs/GetRunCommand" },
        { "$ref": "#/$defs/ListRunsCommand" },
        { "$ref": "#/$defs/StreamEventsCommand" },
        { "$ref": "#/$defs/CancelCommand" },
        { "$ref": "#/$defs/CheckpointCommand" },
        { "$ref": "#/$defs/ResumeCommand" },
        { "$ref": "#/$defs/ResolveApprovalCommand" },
        { "$ref": "#/$defs/RecordCorrectionCommand" },
        { "$ref": "#/$defs/ExplainArtifactCommand" },
        { "$ref": "#/$defs/GetCapabilitiesCommand" }
      ]
    },

    "StartRunCommand": {
      "type": "object",
      "required": ["name", "commandId", "idempotencyKey", "runId", "payload"],
      "properties": {
        "name": { "const": "StartRun" },
        "commandId": { "type": "string", "minLength": 1 },
        "idempotencyKey": { "type": "string", "minLength": 1 },
        "actor": { "type": "string" },
        "runId": { "$ref": "primitives.schema.json#/$defs/RunId" },
        "payload": {
          "type": "object",
          "required": ["manifestPath", "repoPath", "brief"],
          "properties": {
            "manifestPath": { "type": "string", "minLength": 1 },
            "repoPath": { "type": "string", "minLength": 1 },
            "brief": { "type": "string", "minLength": 1 },
            "profileId": { "type": "string", "minLength": 1 },
            "model": {
              "$comment": "Model route ID for this run. Authority-bearing: it selects the route and therefore the pricing/accounting vector.",
              "type": "string",
              "minLength": 1
            },
            "episodeId": {
              "$comment": "Caller-supplied episode identity. The service mints a UUIDv7 when absent.",
              "$ref": "primitives.schema.json#/$defs/Identifier"
            },
            "expectedSeq": { "$ref": "#/$defs/SeqGuard" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "GetRunCommand": {
      "type": "object",
      "required": ["name", "commandId", "idempotencyKey", "runId"],
      "properties": {
        "name": { "const": "GetRun" },
        "commandId": { "type": "string", "minLength": 1 },
        "idempotencyKey": { "type": "string", "minLength": 1 },
        "actor": { "type": "string" },
        "runId": { "$ref": "primitives.schema.json#/$defs/RunId" },
        "payload": {
          "type": "object",
          "properties": {
            "expectedSeq": { "$ref": "#/$defs/SeqGuard" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ListRunsCommand": {
      "$comment": "Not run-scoped: runId, when present, must be empty (wire convention: the field is always sent, blank when inapplicable).",
      "type": "object",
      "required": ["name", "commandId", "idempotencyKey"],
      "properties": {
        "name": { "const": "ListRuns" },
        "commandId": { "type": "string", "minLength": 1 },
        "idempotencyKey": { "type": "string", "minLength": 1 },
        "actor": { "type": "string" },
        "runId": { "const": "" },
        "payload": {
          "type": "object",
          "properties": {
            "limit": { "type": "integer", "minimum": 1, "maximum": 500 },
            "offset": {
              "$comment": "Offset paging. `cursor` was specified here but never implemented, never emitted by any client, and never written to the wire; the served implementation has always paged by limit/offset.",
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "StreamEventsCommand": {
      "type": "object",
      "required": ["name", "commandId", "idempotencyKey", "runId"],
      "properties": {
        "name": { "const": "StreamEvents" },
        "commandId": { "type": "string", "minLength": 1 },
        "idempotencyKey": { "type": "string", "minLength": 1 },
        "actor": { "type": "string" },
        "runId": { "$ref": "primitives.schema.json#/$defs/RunId" },
        "payload": {
          "type": "object",
          "properties": {
            "afterSeq": { "$ref": "primitives.schema.json#/$defs/IntString" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "CancelCommand": {
      "type": "object",
      "required": ["name", "commandId", "idempotencyKey", "runId"],
      "properties": {
        "name": { "const": "Cancel" },
        "commandId": { "type": "string", "minLength": 1 },
        "idempotencyKey": { "type": "string", "minLength": 1 },
        "actor": { "type": "string" },
        "runId": { "$ref": "primitives.schema.json#/$defs/RunId" },
        "payload": {
          "type": "object",
          "properties": {
            "reason": { "type": "string" },
            "expectedSeq": { "$ref": "#/$defs/SeqGuard" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "CheckpointCommand": {
      "type": "object",
      "required": ["name", "commandId", "idempotencyKey", "runId"],
      "properties": {
        "name": { "const": "Checkpoint" },
        "commandId": { "type": "string", "minLength": 1 },
        "idempotencyKey": { "type": "string", "minLength": 1 },
        "actor": { "type": "string" },
        "runId": { "$ref": "primitives.schema.json#/$defs/RunId" },
        "payload": {
          "type": "object",
          "properties": {
            "reason": { "type": "string" },
            "expectedSeq": { "$ref": "#/$defs/SeqGuard" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ResumeCommand": {
      "type": "object",
      "required": ["name", "commandId", "idempotencyKey", "runId"],
      "properties": {
        "name": { "const": "Resume" },
        "commandId": { "type": "string", "minLength": 1 },
        "idempotencyKey": { "type": "string", "minLength": 1 },
        "actor": { "type": "string" },
        "runId": { "$ref": "primitives.schema.json#/$defs/RunId" },
        "payload": {
          "type": "object",
          "properties": {
            "checkpointId": { "type": "string" },
            "expectedSeq": { "$ref": "#/$defs/SeqGuard" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ResolveApprovalCommand": {
      "type": "object",
      "required": ["name", "commandId", "idempotencyKey", "runId", "payload"],
      "properties": {
        "name": { "const": "ResolveApproval" },
        "commandId": { "type": "string", "minLength": 1 },
        "idempotencyKey": { "type": "string", "minLength": 1 },
        "actor": { "type": "string" },
        "runId": { "$ref": "primitives.schema.json#/$defs/RunId" },
        "payload": {
          "type": "object",
          "required": ["decision"],
          "properties": {
            "decision": { "$ref": "#/$defs/ApprovalDecision" },
            "expectedSeq": { "$ref": "#/$defs/SeqGuard" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "RecordCorrectionCommand": {
      "type": "object",
      "required": ["name", "commandId", "idempotencyKey", "runId", "payload"],
      "properties": {
        "name": { "const": "RecordCorrection" },
        "commandId": { "type": "string", "minLength": 1 },
        "idempotencyKey": { "type": "string", "minLength": 1 },
        "actor": { "type": "string" },
        "runId": { "$ref": "primitives.schema.json#/$defs/RunId" },
        "payload": {
          "type": "object",
          "required": ["correction"],
          "properties": {
            "correction": {
              "$comment": "Deep-validated by the CorrectionRecord wire reader (parse_wire), not re-specified here.",
              "type": "object"
            },
            "expectedSeq": { "$ref": "#/$defs/SeqGuard" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ExplainArtifactCommand": {
      "$comment": "Run-scope optional per integration_plan.md §4.4: runId may be present or absent, never forbidden.",
      "type": "object",
      "required": ["name", "commandId", "idempotencyKey", "payload"],
      "properties": {
        "name": { "const": "ExplainArtifact" },
        "commandId": { "type": "string", "minLength": 1 },
        "idempotencyKey": { "type": "string", "minLength": 1 },
        "actor": { "type": "string" },
        "runId": { "$ref": "primitives.schema.json#/$defs/RunId" },
        "payload": {
          "type": "object",
          "required": ["artifactId"],
          "properties": {
            "artifactId": { "$ref": "primitives.schema.json#/$defs/ArtifactId" },
            "substrateProfile": { "type": "string" },
            "expectedSeq": { "$ref": "#/$defs/SeqGuard" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "GetCapabilitiesCommand": {
      "$comment": "Not run-scoped: runId, when present, must be empty (wire convention: the field is always sent, blank when inapplicable).",
      "type": "object",
      "required": ["name", "commandId", "idempotencyKey"],
      "properties": {
        "name": { "const": "GetCapabilities" },
        "commandId": { "type": "string", "minLength": 1 },
        "idempotencyKey": { "type": "string", "minLength": 1 },
        "actor": { "type": "string" },
        "runId": { "const": "" },
        "payload": { "type": "object", "additionalProperties": false }
      },
      "additionalProperties": false
    }
  }
}
