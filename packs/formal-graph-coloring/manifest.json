      "formal-graph-coloring/read-tool.json",
      "formal-graph-coloring/witness-tool.json"
    ],
    "context_policy": ["formal-graph-coloring/context-policy.json"],
    "approval_policy": ["formal-graph-coloring/approval-policy.json"]
