{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vanguard.dev/schemas/v4/harness-manifest.reader.schema.json",
  "$comment": "READER PROFILE, generated by tools/reader_profile.py. Do not edit.",
  "title": "HarnessManifest",
  "type": "object",
  "required": [
    "harness",
    "components",
    "capabilities",
    "evaluators",
    "budgetPolicy"
  ],
  "properties": {
    "harness": {
      "type": "string",
      "minLength": 1
    },
    "components": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "verb",
          "sink",
          "selector",
          "risk"
        ],
        "properties": {
          "verb": {
            "type": "string",
            "minLength": 1
          },
          "sink": {
            "enum": [
              "pure",
              "observation",
              "privileged"
            ]
          },
          "selector": {
            "$ref": "resource-selector.reader.schema.json"
          },
          "risk": {
            "$ref": "primitives.reader.schema.json#/$defs/RiskTier"
          }
        },
        "additionalProperties": true
      }
    },
    "evaluators": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "budgetPolicy": {
      "type": "string",
      "minLength": 1
    },
    "undeletable": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}