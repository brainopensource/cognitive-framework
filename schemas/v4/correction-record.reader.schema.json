{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vanguard.dev/schemas/v4/correction-record.reader.schema.json",
  "$comment": "READER PROFILE, generated by tools/reader_profile.py. Do not edit.",
  "title": "CorrectionRecord",
  "type": "object",
  "required": [
    "episodeId",
    "proposedPatchDigest",
    "acceptedPatchDigest",
    "reasonCodes",
    "magnitude",
    "scope",
    "correctingPrincipalRole"
  ],
  "properties": {
    "episodeId": {
      "$ref": "primitives.reader.schema.json#/$defs/EpisodeId"
    },
    "proposedPatchDigest": {
      "$ref": "primitives.reader.schema.json#/$defs/Digest"
    },
    "acceptedPatchDigest": {
      "$ref": "primitives.reader.schema.json#/$defs/Digest"
    },
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "functional_defect",
          "missing_requirement",
          "security_policy",
          "test_inadequacy",
          "maintainability",
          "architecture_preference",
          "style",
          "product_change",
          "environment_change",
          "reviewer_disagreement"
        ]
      }
    },
    "magnitude": {
      "enum": [
        "minor",
        "moderate",
        "major"
      ]
    },
    "scope": {
      "enum": [
        "user",
        "team",
        "repo",
        "domain",
        "general"
      ]
    },
    "correctingPrincipalRole": {
      "enum": [
        "user",
        "operator",
        "episode",
        "process",
        "evaluator",
        "release"
      ]
    }
  },
  "additionalProperties": true
}