{
  "name": "@aether/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "AETHER native desktop application and developer workspace",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./bridge": {
      "types": "./dist/src/bridge/tauri-bridge.d.ts",
      "default": "./dist/src/bridge/tauri-bridge.js"
    },
    "./state": {
      "types": "./dist/src/state/desktop-store.d.ts",
      "default": "./dist/src/state/desktop-store.js"
    }
  },
  "files": [
    "dist/src/**/*.js",
    "dist/src/**/*.d.ts",
    "dist-browser/**/*",
    "index.html",
    "README.md",
    "scripts/**/*.mjs"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:browser": "node scripts/build-browser.mjs",
    "dev": "npm run build:browser && node scripts/serve-desktop.mjs",
    "start": "node ../../../bin/aether-desktop",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build --silent && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@aether/contracts": "*",
    "@aether/client": "*",
    "@aether/projections": "*",
    "@aether/ui-web": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "esbuild": "^0.28.2"
  }
}
