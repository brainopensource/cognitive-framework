{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vanguard.dev/schemas/mhf/event_envelope.schema.json",
  "$comment": "RFC 8785 JCS canonical envelope. Canonical live writes are hash-chained and sequenced per project_id via prev_digest. Nullable lineage fields remain only for compatibility readers of historical rows; the production LedgerEmitter supplies project_id, principal_id, harness_digest, causation/correlation defaults, and the applicable episode lineage. SPEC \u00a71.2.",
  "title": "EventEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "kind",
    "seq",
    "occurred_at",
    "run_id",
    "principal",
    "payload",
    "digest"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "mhf.event/1"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "$ref": "#/$defs/EventKind"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "occurred_at": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "episode_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "parent_episode_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "principal": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ],
      "$comment": "ADR-0074 \u00a75 consistency unit. Nullable only for compatibility reads; canonical live writers require a non-empty value."
    },
    "principal_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "parent_principal_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "harness_digest": {
      "type": [
        "string",
        "null"
      ],
      "$comment": "D_H of the composition under which this event was produced (ADR-0071)."
    },
    "branch_id": {
      "type": "string",
      "default": "main"
    },
    "prev_digest": {
      "type": [
        "string",
        "null"
      ]
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object"
    },
    "alertable": {
      "type": "boolean",
      "default": false
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "EventKind": {
      "title": "EventKind",
      "type": "string",
      "enum": [
        "RunStarted",
        "EpisodeStarted",
        "TurnStarted",
        "EpisodeCompleted",
        "RunCompleted",
        "RunAborted",
        "RunRecovered",
        "ProposalProduced",
        "ProposalRejected",
        "ReflectionProduced",
        "AuthorizationRequested",
        "AuthorizationDenied",
        "CapabilityGranted",
        "CapabilityAttenuated",
        "CapabilityRevoked",
        "BudgetReserved",
        "BudgetCommitted",
        "BudgetReleased",
        "BudgetExhausted",
        "EffectStarted",
        "EffectCompleted",
        "EffectFailed",
        "EffectRejected",
        "EffectReconciled",
        "EvaluationRequested",
        "VerdictRecorded",
        "ClaimRecorded",
        "InvalidationChecked",
        "ApprovalRequested",
        "ApprovalResolved",
        "KernelAlarm",
        "PluginDiscovered",
        "PluginResolved",
        "PluginVerified",
        "PluginActivated",
        "PluginQuiesced",
        "PluginRetired",
        "PluginFaulted",
        "Heartbeat",
        "CheckpointCreated",
        "ChildSpawned",
        "ChildReturned",
        "ActivationChanged",
        "ArtifactCreated",
        "CompetencePriorRecorded",
        "ConflictDetected",
        "EffectPreviewed",
        "EpisodeStateChanged",
        "EvidenceClaimProduced",
        "ObservationProduced",
        "ObservationRequested",
        "OperatorInvoked",
        "OperatorSelected",
        "CorrectionRecorded",
        "CandidateBuilt",
        "CandidateAttested",
        "CanaryPromoted",
        "RollbackTriggered",
        "GoalDeclared",
        "PlanRevised",
        "StrategyChanged",
        "ProgressAssessed",
        "ContextCompacted"
      ],
      "description": "ADR-0098 Decision 3/4/5: the eight live VG-04 kinds, the eight deprecated-but-readable historical kinds, and the five M-5a semantic kinds are folded in, making this enum the sole live event-kind authority. Deprecation is a write rule (DEPRECATED_KINDS), not an absence from the vocabulary -- a historical ledger legally contains these names."
    }
  }
}
