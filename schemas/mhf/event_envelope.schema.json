{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vanguard.dev/schemas/mhf/event_envelope.schema.json",
  "$comment": "RFC 8785 JCS canonical envelope. Hash-chained per run via prev_digest. SPEC §1.2.",
  "title": "EventEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "kind",
    "seq",
    "occurred_at",
    "run_id",
    "principal",
    "payload",
    "digest"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "mhf.event/1" },
    "event_id": { "type": "string", "minLength": 1 },
    "kind": { "$ref": "#/$defs/EventKind" },
    "seq": { "type": "integer", "minimum": 0 },
    "occurred_at": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "episode_id": { "type": ["string", "null"] },
    "principal": { "type": "string", "minLength": 1 },
    "branch_id": { "type": "string", "default": "main" },
    "prev_digest": { "type": ["string", "null"] },
    "causation_id": { "type": ["string", "null"] },
    "correlation_id": { "type": ["string", "null"] },
    "idempotency_key": { "type": ["string", "null"] },
    "payload": { "type": "object" },
    "alertable": { "type": "boolean", "default": false },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "$defs": {
    "EventKind": {
      "title": "EventKind",
      "type": "string",
      "enum": [
        "RunStarted",
        "EpisodeStarted",
        "TurnStarted",
        "EpisodeCompleted",
        "RunCompleted",
        "RunAborted",
        "RunRecovered",
        "ProposalProduced",
        "ProposalRejected",
        "ReflectionProduced",
        "AuthorizationRequested",
        "AuthorizationDenied",
        "CapabilityGranted",
        "CapabilityAttenuated",
        "CapabilityRevoked",
        "BudgetReserved",
        "BudgetCommitted",
        "BudgetReleased",
        "BudgetExhausted",
        "EffectStarted",
        "EffectCompleted",
        "EffectFailed",
        "EffectRejected",
        "EffectReconciled",
        "EvaluationRequested",
        "VerdictRecorded",
        "ClaimRecorded",
        "InvalidationChecked",
        "ApprovalRequested",
        "ApprovalResolved",
        "KernelAlarm",
        "PluginResolved",
        "PluginActivated",
        "PluginQuiesced",
        "PluginRetired",
        "PluginFaulted",
        "Heartbeat",
        "CheckpointCreated",
        "ChildSpawned",
        "ChildReturned"
      ]
    }
  }
}
