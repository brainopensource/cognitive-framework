{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vanguard.dev/schemas/v4/artifact.schema.json",
  "$comment": "Owning section: 04 §10; GTS-13C T1.8. Kinds are registry strings, never a closed enum.",
  "title": "Artifact",
  "type": "object",
  "required": ["artifactId", "kind", "class", "hypothesis", "evidenceRefs", "invalidationConditions", "riskDelta", "contentDigest"],
  "properties": {
    "artifactId": { "$ref": "primitives.schema.json#/$defs/ArtifactId" },
    "kind": { "type": "string", "minLength": 1 },
    "class": { "enum": ["enforcement", "compensation"] },
    "compensatesFor": { "type": "string", "minLength": 1 },
    "hypothesis": { "type": "string", "minLength": 1 },
    "evidenceRefs": { "type": "array", "items": { "$ref": "primitives.schema.json#/$defs/Digest" } },
    "invalidationConditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["condition", "checkKind"],
        "properties": {
          "condition": { "type": "string", "minLength": 1 },
          "checkKind": { "enum": ["automatic", "scheduled", "manual"] },
          "checkRef": { "$ref": "primitives.schema.json#/$defs/EvaluatorId" }
        },
        "additionalProperties": false
      }
    },
    "riskDelta": { "type": "integer" },
    "contentDigest": { "$ref": "primitives.schema.json#/$defs/Digest" }
  },
  "additionalProperties": false,
  "oneOf": [
    { "properties": { "class": { "const": "compensation" } }, "required": ["class", "compensatesFor"] },
    { "properties": { "class": { "const": "enforcement" } }, "required": ["class"], "not": { "required": ["compensatesFor"] } }
  ]
}
