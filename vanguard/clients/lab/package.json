{
  "name": "@aether/lab",
  "version": "0.1.0",
  "description": "AETHER precision inspection and engineering surface",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./state": {
      "types": "./dist/src/state/lab-store.d.ts",
      "default": "./dist/src/state/lab-store.js"
    },
    "./components": {
      "types": "./dist/src/components/LabApp.d.ts",
      "default": "./dist/src/components/LabApp.js"
    }
  },
  "files": [
    "dist/src/**/*.js",
    "dist/src/**/*.d.ts",
    "index.html",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build --silent && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@aether/contracts": "*",
    "@aether/client": "*",
    "@aether/projections": "*",
    "@aether/ui-web": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
