#!/usr/bin/env node

/**
 * AETHER — Self-Contained Production TUI Binary Entrypoint
 *
 * Runs interactive terminal cockpit without dev dependencies.
 */

import { dirname, resolve } from "node:path";
import { fileURLToPath } from "node:url";

const __filename = fileURLToPath(import.meta.url);
const __dirname = dirname(__filename);

// Resolve package root relative to bin directory
const packageRoot = resolve(__dirname, "..");
if (!process.env.AETHER_HOME) {
  process.env.AETHER_HOME = packageRoot;
}

// Forward to TUI entrypoint
const tuiMain = resolve(packageRoot, "vanguard", "clients", "tui", "dist", "src", "main.js");

import(tuiMain).catch((err) => {
  console.error(`[AETHER TUI] Fatal initialization error:`, err);
  process.exit(1);
});
