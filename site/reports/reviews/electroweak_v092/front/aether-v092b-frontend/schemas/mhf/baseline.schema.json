{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aether.baseline/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "baseline_id",
    "git_tag",
    "tag_object_sha",
    "commit_sha",
    "tree_digest",
    "package_version",
    "dependency_lock_digest",
    "schema_pins",
    "reducer_pins",
    "prohibited_treatment_paths",
    "required_gates",
    "creator",
    "reviewer",
    "signatures"
  ],
  "properties": {
    "schema_version": {
      "const": "aether.baseline/1"
    },
    "baseline_id": {
      "type": "string",
      "pattern": "^[A-Z0-9_-]+$"
    },
    "git_tag": {
      "type": "string",
      "minLength": 1
    },
    "tag_object_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "tree_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "package_version": {
      "type": "string",
      "minLength": 1
    },
    "dependency_lock_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "schema_pins": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      }
    },
    "reducer_pins": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      }
    },
    "prohibited_treatment_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "required_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "creator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "public_key"],
      "properties": {
        "key_id": {
          "type": "string",
          "minLength": 1
        },
        "public_key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "public_key"],
      "properties": {
        "key_id": {
          "type": "string",
          "minLength": 1
        },
        "public_key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "signatures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["creator", "reviewer"],
      "properties": {
        "creator": {
          "type": "string",
          "minLength": 1
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
