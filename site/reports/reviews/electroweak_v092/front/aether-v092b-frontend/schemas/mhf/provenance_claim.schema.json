{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vanguard.dev/schemas/mhf/provenance_claim.schema.json",
  "title": "ProvenanceClaimPayload",
  "type": "object",
  "additionalProperties": false,
  "required": ["claimKind", "turnIndex"],
  "properties": {
    "claimKind": {
      "type": "string",
      "enum": [
        "context_selection",
        "compaction",
        "cache_interaction",
        "reproducibility_at_run_close",
        "reproducibility_current"
      ]
    },
    "turnIndex": { "type": "integer", "minimum": 0 },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "paramsDigest"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" },
        "paramsDigest": { "type": "string" }
      }
    },
    "inputDigest": { "type": "string" },
    "outputDigest": { "type": "string" },
    "inputArtifacts": { "type": "array", "items": { "type": "string" } },
    "outputArtifacts": { "type": "array", "items": { "type": "string" } },
    "metrics": { "type": "object" },
    "selectedLabels": { "type": "array", "items": { "type": "string" } },
    "droppedLabels": { "type": "array", "items": { "type": "string" } },
    "elidedLabels": { "type": "array", "items": { "type": "string" } },
    "cacheId": { "type": "string" },
    "keyDigest": { "type": "string" },
    "sourceDigest": { "type": "string" },
    "hit": { "type": "boolean" },
    "sourceStatus": { "type": "string" },
    "vector": { "type": "object" },
    "basis": { "type": "array", "items": { "type": "string" } },
    "reducerVersion": { "type": "string" },
    "schemaVersions": { "type": "object" },
    "stateReconstructionReceipt": { "type": "object" },
    "semanticReplayReceipt": { "type": "object" }
  }
}
