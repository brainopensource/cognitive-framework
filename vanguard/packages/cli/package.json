{
  "name": "@vanguard/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "vg": "dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build --silent && node --test --test-isolation=none dist/test/*.test.js",
    "vg": "node --import tsx/esm src/main.tsx"
  },
  "dependencies": {
    "ink": "^5.1.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
