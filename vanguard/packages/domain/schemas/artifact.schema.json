{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vanguard.dev/schemas/v4/artifact.schema.json",
  "$comment": "Candidate implementing 04 §10.2 and INV-1.",
  "title": "Artifact",
  "type": "object",
  "required": ["id", "kind", "artifactVersion", "body", "interfaceSchema", "createdBy", "createdFrom", "dependencies", "supersedes", "contentDigest", "createdAt", "invalidationConditions"],
  "properties": {
    "id": { "$ref": "../../../../schemas/v4/primitives.schema.json#/$defs/ArtifactId" },
    "kind": { "enum": ["R", "O", "M", "P"] },
    "artifactVersion": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "body": { "$ref": "../../../../schemas/v4/primitives.schema.json#/$defs/Digest" },
    "interfaceSchema": { "type": "string", "minLength": 1 },
    "createdBy": { "$ref": "../../../../schemas/v4/primitives.schema.json#/$defs/PrincipalId" },
    "createdFrom": { "type": "array", "items": { "$ref": "../../../../schemas/v4/primitives.schema.json#/$defs/ArtifactId" } },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact", "versionRange"],
        "properties": { "artifact": { "$ref": "../../../../schemas/v4/primitives.schema.json#/$defs/ArtifactId" }, "versionRange": { "type": "string", "minLength": 1 } },
        "additionalProperties": false
      }
    },
    "supersedes": { "type": "array", "items": { "$ref": "../../../../schemas/v4/primitives.schema.json#/$defs/ArtifactId" } },
    "contentDigest": { "$ref": "../../../../schemas/v4/primitives.schema.json#/$defs/Digest" },
    "createdAt": { "$ref": "../../../../schemas/v4/primitives.schema.json#/$defs/Timestamp" },
    "invalidationConditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["condition", "checkKind"],
        "properties": {
          "condition": { "type": "string", "minLength": 1 },
          "checkKind": { "enum": ["automatic", "scheduled", "manual"] },
          "checkRef": { "$ref": "../../../../schemas/v4/primitives.schema.json#/$defs/EvaluatorId" }
        },
        "additionalProperties": false,
        "allOf": [{ "if": { "properties": { "checkKind": { "const": "automatic" } }, "required": ["checkKind"] }, "then": { "required": ["checkRef"] } }]
      }
    }
  },
  "additionalProperties": false
}
