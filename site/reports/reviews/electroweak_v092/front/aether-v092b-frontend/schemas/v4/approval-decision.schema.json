{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vanguard.dev/schemas/v4/approval-decision.schema.json",
  "$comment": "Owning contract: REQ-APP-001, DEC-6B-022, ADR-0062. Asymmetric Ed25519 approval decision.",
  "title": "ApprovalDecision",
  "type": "object",
  "required": [
    "approvalId",
    "resolution",
    "reviewer",
    "argsDigest",
    "descriptorDigest",
    "expiresAt",
    "keyId",
    "signature"
  ],
  "properties": {
    "approvalId": { "$ref": "primitives.schema.json#/$defs/ApprovalId" },
    "resolution": { "enum": ["approved", "rejected"] },
    "reviewer": { "type": "string", "minLength": 1 },
    "argsDigest": { "$ref": "primitives.schema.json#/$defs/Digest" },
    "descriptorDigest": { "$ref": "primitives.schema.json#/$defs/Digest" },
    "expiresAt": { "$ref": "primitives.schema.json#/$defs/Timestamp" },
    "keyId": { "type": "string", "minLength": 1 },
    "signature": { "type": "string", "pattern": "^[0-9a-fA-F]{128}$" }
  },
  "additionalProperties": false
}
