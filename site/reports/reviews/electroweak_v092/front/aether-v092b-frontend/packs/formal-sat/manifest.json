{
  "harness": "vg-formal-sat",
  "components": {
    "system_prompt": ["formal-sat/system-prompt.txt"],
    "tools": [
      "formal-sat/read-tool.json",
      "formal-sat/witness-tool.json"
    ],
    "context_policy": ["formal-sat/context-policy.json"],
    "approval_policy": ["formal-sat/approval-policy.json"]
  },
  "capabilities": [
    {
      "verb": "fs.read",
      "sink": "observation",
      "selector": {"kind":"fs","root":"/workspace","paths":["/workspace"]},
      "risk": "low"
    },
    {
      "verb": "patch.apply",
      "sink": "privileged",
      "selector": {"kind":"fs","root":"/workspace","paths":["/workspace"]},
      "risk": "medium"
    }
  ],
  "evaluators": ["formal-sat-exterior@1"],
  "budgetPolicy": "formal-sat/budget-policy.json",
  "undeletable": false
}
