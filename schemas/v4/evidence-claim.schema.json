{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vanguard.dev/schemas/v4/evidence-claim.schema.json",
  "$comment": "Owning section: 04 \u00a710.2. INV-1 is enforced structurally here: invalidationConditions is required and non-empty.",
  "title": "EvidenceClaim",
  "type": "object",
  "required": [
    "id",
    "subject",
    "predicate",
    "value",
    "protocol",
    "evaluator",
    "environmentProfile",
    "substrateProfile",
    "taskDistribution",
    "uncertainty",
    "validity",
    "invalidationConditions"
  ],
  "properties": {
    "id": {
      "$ref": "primitives.schema.json#/$defs/ClaimId"
    },
    "subject": {
      "type": "string",
      "$comment": "ArtifactId | RunId | CandidateId"
    },
    "predicate": {
      "type": "string"
    },
    "value": {},
    "protocol": {
      "$ref": "primitives.schema.json#/$defs/Digest"
    },
    "evaluator": {
      "type": "object",
      "required": [
        "evaluatorId",
        "class",
        "imageDigest"
      ],
      "properties": {
        "evaluatorId": {
          "$ref": "primitives.schema.json#/$defs/EvaluatorId"
        },
        "class": {
          "enum": [
            "mechanically_reproducible",
            "externally_grounded",
            "human_adjudicated",
            "learned_proxy",
            "composite",
            "inconclusive"
          ],
          "$comment": "06 \u00a74: no class receives abstract objectivity. Claim strength is predicate-scoped."
        },
        "imageDigest": {
          "$ref": "primitives.schema.json#/$defs/Digest"
        }
      },
      "additionalProperties": false
    },
    "environmentProfile": {
      "$ref": "primitives.schema.json#/$defs/Digest"
    },
    "substrateProfile": {
      "$ref": "primitives.schema.json#/$defs/Digest"
    },
    "taskDistribution": {
      "$ref": "primitives.schema.json#/$defs/Digest"
    },
    "uncertainty": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "interval",
            "point",
            "qualitative",
            "unknown"
          ]
        },
        "lower": {
          "type": "number"
        },
        "upper": {
          "type": "number"
        },
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "validity": {
      "type": "object",
      "required": [
        "domains"
      ],
      "properties": {
        "domains": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "$comment": "Where the claim held. Distinct from what would show it no longer holds."
    },
    "invalidationConditions": {
      "type": "array",
      "minItems": 1,
      "$comment": "INV-1: a claim that cannot state what would refute it is not admissible. An empty array fails at parse.",
      "items": {
        "type": "object",
        "required": [
          "condition",
          "checkKind"
        ],
        "properties": {
          "condition": {
            "type": "string",
            "minLength": 1
          },
          "checkKind": {
            "enum": [
              "automatic",
              "scheduled",
              "manual"
            ]
          },
          "checkRef": {
            "$ref": "primitives.schema.json#/$defs/EvaluatorId"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "checkKind": {
                  "const": "automatic"
                }
              },
              "required": [
                "checkKind"
              ]
            },
            "then": {
              "required": [
                "checkRef"
              ]
            }
          }
        ],
        "additionalProperties": false,
        "$comment": "CT-53: no mutable field inside a content-addressed artifact. Check state lives in InvalidationCheckRecord."
      }
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "$ref": "primitives.schema.json#/$defs/Digest"
      }
    },
    "derivedFrom": {
      "type": "array",
      "items": {
        "$ref": "primitives.schema.json#/$defs/ClaimId"
      }
    },
    "contradicts": {
      "type": "array",
      "items": {
        "$ref": "primitives.schema.json#/$defs/ClaimId"
      }
    },
    "expiresAt": {
      "$ref": "primitives.schema.json#/$defs/Timestamp"
    }
  },
  "additionalProperties": false
}