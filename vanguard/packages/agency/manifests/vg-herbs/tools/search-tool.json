{
  "name": "search",
  "verb": "fs.search",
  "description": "Search workspace files for a pattern or glob filter.",
  "schema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "description": "Workspace-relative directory or file."
      },
      "pattern": {
        "type": "string",
        "description": "Literal or regex pattern."
      },
      "glob": {
        "type": "string",
        "description": "Glob pattern filter."
      },
      "max_results": {
        "type": "integer",
        "description": "Maximum matching snippets."
      }
    },
    "required": [
      "path",
      "pattern"
    ],
    "additionalProperties": false
  }
}
